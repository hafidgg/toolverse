# Database
# Neon (https://console.neon.tech) — Connection details, same branch for both:
# pooled URL (host contains "-pooler") for the app at runtime,
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# direct URL (no "-pooler") for Prisma migrations (schema.prisma → directUrl).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Site
NEXT_PUBLIC_SITE_URL="https://toolverse.example.com"

# Admin auth
ADMIN_SESSION_SECRET="replace-with-a-random-64-char-secret-generated-via-openssl-rand-hex-32"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Rate limiting (Upstash Redis) — REQUIRED for real protection in production.
# Without these set, the app falls back to an in-memory limiter that only
# works correctly on a single-instance server (e.g. local dev) — it does NOT
# provide real protection on Vercel/serverless, where each request can hit a
# different instance with its own memory. Get free credentials at
# https://console.upstash.com (Redis database → REST API section).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Email (Resend) — newsletter + admin notifications
RESEND_API_KEY=""

# Analytics / Ads
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""  # currently UNUSED — the AdSense client ID is read from Admin → Settings (adsenseClientId)
# AdSense ad-unit slot IDs (numeric). An AdSlot renders nothing unless its slot ID
# is set here AND a valid client ID (ca-pub-…) is saved in Admin → Settings.
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=""
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=""
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=""
